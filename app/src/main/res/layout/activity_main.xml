<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- 顶部 Header: 居中标题与副标 + 右侧圆形刷新/扫描按钮 (紧凑高阶质感) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HQPE Streamer"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android to HQPlayer DLNA"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_scan_devices"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_header_circle_btn"
                android:src="@drawable/ic_refresh"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary"
                android:contentDescription="扫描局域网设备" />
        </RelativeLayout>

        <!-- 1. 目标设备卡片 (HQPlayer DLNA/UPnP) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="目标设备 (HQPlayer)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DLNA / UPnP"
                        android:textSize="10sp"
                        android:textColor="@color/accent_cyan"
                        android:background="@drawable/bg_diag_panel"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_scan_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击右上角按钮扫描局域网 MediaRenderer"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <!-- 设备选择 Spinner -->
                <Spinner
                    android:id="@+id/spinner_devices"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_spinner_dark"
                    android:spinnerMode="dropdown" />

                <!-- 手动输入 IP 与端口 (紧凑风格) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:hint="HQPE IP"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        android:textColorHint="@color/text_secondary"
                        app:hintTextColor="@color/primary_blue"
                        android:layout_marginEnd="6dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_hqpe_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10.10.10.120"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="端口"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        android:textColorHint="@color/text_secondary"
                        app:hintTextColor="@color/primary_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_hqpe_port"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="49152"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 控制端点小字单行折叠/省略展示 -->
                <TextView
                    android:id="@+id/tv_control_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="控制端点: 自动解析或默认"
                    android:textSize="10.5sp"
                    android:textColor="@color/text_muted"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:layout_marginTop="3dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 本机推流设置卡片 (HTTP Live Stream) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本机推流设置 (HTTP Live Stream)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="本机局域网 IP (出口网卡)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        android:textColorHint="@color/text_secondary"
                        app:hintTextColor="@color/primary_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_local_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="自动探测"
                        android:textSize="12sp"
                        android:layout_marginStart="6dp"
                        app:cornerRadius="8dp"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp"
                        app:backgroundTint="@color/input_bg"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_stream_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="推流地址: 待就绪"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:textColor="@color/primary_blue" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="状态: 待机就绪"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:layout_marginTop="4dp" />

                <!-- 精简的一行外放提示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_info_box"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tv_mute_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 提示: 若外放有声，按音量键调低即可，不影响内录与抓流。"
                        android:textSize="10.5sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. 音频捕获实时诊断信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音频捕获实时诊断 (Audio Diagnostics)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <!-- 仪表盘面板 (紧凑) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_diag_panel"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_capture_diag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚪ STOPPED  |  0.0 KB/s  |  -96.0 dB"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:textColor="@color/accent_green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_diag_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="@color/accent_amber"
                    android:background="@drawable/bg_alert_box"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. 控制操作按钮 (并排双胶囊实体按键，高度 48dp，首屏无滑动完整展示) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="开始投送音频"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/btn_start_background"
                android:textColor="@color/btn_text_color"
                app:strokeColor="@color/btn_stroke_color"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="停止投送"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:enabled="false"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/btn_stop_background"
                android:textColor="@color/btn_text_color"
                app:strokeColor="@color/btn_stroke_color"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
