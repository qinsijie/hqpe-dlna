<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1. 顶部 Header 与快捷操作按钮 -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HQPE Streamer"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.02" />

                <!-- Hi-Fi Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HI-FI"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:background="@drawable/bg_diag_panel"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:layout_marginStart="6dp" />

                <!-- Version Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0"
                    android:textSize="9sp"
                    android:textColor="#94A3B8"
                    android:background="@drawable/bg_info_box"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bit-Perfect DLNA Audio Transporter"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 右侧扫描与配置抽屉呼出按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_scan_devices"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_circle_btn"
                android:src="@drawable/ic_refresh"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary"
                android:contentDescription="扫描局域网设备" />

            <ImageButton
                android:id="@+id/btn_open_config"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_header_circle_btn"
                android:src="@drawable/ic_settings"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary"
                android:contentDescription="设备与推流配置" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 目标渲染器浮动卡片 (点击呼出配置抽屉) -->
    <LinearLayout
        android:id="@+id/card_target_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_header"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card_interactive"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_status_active">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_renderer"
                app:tint="@color/cyan_neon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HQPlayer Embedded"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 在线状态绿点 -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_header_circle_btn"
                    android:backgroundTint="@color/accent_green"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_device_ip_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.10.10.120:49152 · 就绪"
                android:textSize="11.5sp"
                android:typeface="monospace"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 底部推流端点信息条 (置于底部) -->
    <LinearLayout
        android:id="@+id/layout_endpoint_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginBottom="4dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_status_idle">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_stream_link"
                app:tint="@color/cyan_neon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机推流端点 (HTTP STREAM)"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stream_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://10.10.10.22:8088/stream.wav"
                android:textSize="11.5sp"
                android:typeface="monospace"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/text_primary"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_url"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="复制"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/cyan_neon"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/input_bg"
            app:strokeColor="@color/input_stroke"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- 4. 主控核心：居中发光触控大圆环与音响级动态只读 HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/card_target_device"
        android:layout_above="@id/layout_endpoint_panel"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 旋钮外发光与主控触控大圆环 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <!-- 装饰外环 -->
            <View
                android:id="@+id/view_dial_outer_ring"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dial_outer_ring" />

            <!-- 发光触控实体大圆环 -->
            <FrameLayout
                android:id="@+id/btn_master_dial"
                android:layout_width="212dp"
                android:layout_height="212dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dial_idle"
                android:clickable="true"
                android:focusable="true">

                <!-- 顶部边缘微光指示圆点 -->
                <View
                    android:id="@+id/view_dial_edge_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_header_circle_btn"
                    android:backgroundTint="@color/cyan_neon" />

                <!-- 居中声波图标与提示 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_dial_wave_icon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_stat_streaming"
                        app:tint="@color/cyan_neon"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_dial_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击开启投送"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_dial_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAP TO ENGAGE"
                        android:textSize="10sp"
                        android:typeface="monospace"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- 5. 动态只读 HUD 参数状态区 (Bit-Perfect 只读监控) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <!-- 状态胶囊标签 -->
            <LinearLayout
                android:id="@+id/layout_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_idle"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_header_circle_btn"
                    android:backgroundTint="@color/text_muted"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待机待命 · 准备就绪"
                    android:textSize="11.5sp"
                    android:typeface="monospace"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 规格 HUD (动态只读跟随曲目真实参数) -->
            <TextView
                android:id="@+id/tv_hud_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz · 16-Bit · 源码直通 | 0.0 KB/s"
                android:textSize="11.5sp"
                android:typeface="monospace"
                android:textColor="@color/cyan_neon"
                android:layout_marginTop="8dp" />

            <!-- 务实提示说明 (不误导独立静音) -->
            <TextView
                android:id="@+id/tv_diag_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提示：若外放有声，按音量键调低即可，不影响推流与抓流。"
                android:textSize="10.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
