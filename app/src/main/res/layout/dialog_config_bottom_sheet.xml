<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- 顶部拖动条指示器 -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_header_circle_btn"
        android:backgroundTint="#475569"
        android:layout_marginBottom="16dp" />

    <!-- 抽屉头部标题与关闭按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="渲染器与推流配置"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HQPlayer UPnP/DLNA 目标参数"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_sheet_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_header_circle_btn"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            app:tint="@color/text_secondary"
            android:contentDescription="关闭配置" />
    </RelativeLayout>

    <!-- 设备选择下拉菜单 (扫描发现的 UPnP 渲染器) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择目标渲染器 (DLNA 发现)"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_sheet_devices"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_spinner_dark"
        android:spinnerMode="dropdown" />

    <!-- 渲染器设备名称 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="目标设备名称 (Friendly Name)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        app:boxBackgroundColor="@color/input_bg"
        app:boxStrokeColor="@color/input_stroke"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/cyan_neon"
        android:layout_marginBottom="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_sheet_dev_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HQPlayer Embedded"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- HQPE 目标 IP 与端口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="HQPE 目标 IP"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/input_bg"
            app:boxStrokeColor="@color/input_stroke"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/cyan_neon"
            android:layout_marginEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sheet_hqpe_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10.10.10.120"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="UPnP 端口"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/input_bg"
            app:boxStrokeColor="@color/input_stroke"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/cyan_neon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sheet_hqpe_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="49152"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- 本机出口 IP 网卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="本机出口 IP 网卡"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxBackgroundColor="@color/input_bg"
            app:boxStrokeColor="@color/input_stroke"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/cyan_neon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sheet_local_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_detect_ip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="自动探测"
            android:textSize="12sp"
            android:layout_marginStart="8dp"
            app:cornerRadius="10dp"
            android:textColor="@color/cyan_neon"
            app:strokeColor="@color/input_stroke"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/input_bg"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- 控制端点小字提示 -->
    <TextView
        android:id="@+id/tv_sheet_control_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="控制端点: 自动解析或默认"
        android:textSize="10.5sp"
        android:textColor="@color/text_muted"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="18dp" />

    <!-- 保存并生效按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="保存并立即生效"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="14dp"
        android:background="@drawable/bg_btn_gradient"
        app:backgroundTint="@null"
        android:textColor="#05070B" />

</LinearLayout>
